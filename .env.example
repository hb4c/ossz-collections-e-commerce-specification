# ─────────────────────────────────────────────────────────────
# OSSZ Collections — environment variables
# Copy to .env for local dev; set these in Vercel → Settings → Environment Variables for production.
# ─────────────────────────────────────────────────────────────

# REQUIRED — PostgreSQL connection string (Neon, Supabase or Vercel Postgres).
# Managed providers give you this; it looks like:
#   postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=

# REQUIRED IN PRODUCTION — a long random string that signs login sessions.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# ── Optional integrations (the site runs without them) ──────────

# AI Concierge (Anthropic). Without a key it falls back to a built-in
# grounded assistant that still uses live product/FAQ data.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Transactional email (Resend). Without a key, order/appointment messages are
# queued and visible in the back office with a one-tap WhatsApp send.
RESEND_API_KEY=
RESEND_FROM="OSSZ Collections <hello@osszcollections.cm>"

# Privacy-friendly analytics (Plausible). Leave blank to load no analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ── Advanced toggles (sensible defaults; usually leave unset) ───

# Database TLS: "require" forces on, "disable" forces off. Auto-detected otherwise.
# DATABASE_SSL=
# Cross-site cookies. "0" uses strict same-site (only if the site is never iframed).
# COOKIE_CROSS_SITE=
# Skip the empty-database self-seed on boot.
# OSSZ_SKIP_BOOTSTRAP=
